{
  "name": "sunbeam-design-system",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "panda codegen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare": "panda codegen",
    "storybook": "panda codegen && panda cssgen --outfile .storybook/panda.css && npx tsx scripts/generate-stories.ts && storybook dev -p 6006",
    "build-storybook": "panda codegen && panda cssgen --outfile .storybook/panda.css && npx tsx scripts/generate-stories.ts && STORYBOOK_BASE=/storybook/ storybook build",
    "test:visual": "playwright test",
    "test:visual:ui": "playwright test --ui",
    "test:plasmic:registry": "npx tsx scripts/validate-plasmic-registry.ts",
    "test:plasmic:kitchen-sink": "playwright test tests/plasmic-kitchen-sink.spec.ts",
    "test:plasmic": "npm run test:plasmic:registry && npm run test:plasmic:kitchen-sink"
  },
  "dependencies": {
    "@ark-ui/react": "^4.0.0",
    "@plasmicapp/react-web": "1.0.30",
    "@sunbeam/beam-ui": "file:../packages/beam-ui",
    "@types/turndown": "^5.0.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.4",
    "react-router-dom": "^7.18.0",
    "turndown": "^7.2.2",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-essentials": "^8.6.0",
    "@storybook/react": "^8.6.0",
    "@storybook/react-vite": "^8.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "postcss": "^8.5.18",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^8.6.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
