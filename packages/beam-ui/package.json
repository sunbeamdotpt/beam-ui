{
  "name": "@sunbeam/beam-ui",
  "version": "0.10.2",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@sunbeam/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "@sunbeam/source": "./src/preset.ts",
      "default": "./dist/preset.js"
    },
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/global.css": "./src/styles/global.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "@sunbeam/source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "@sunbeam/source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "@sunbeam/source": "./src/data/*.ts",
      "default": "./dist/data/*.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "@sunbeam/source": "./src/form/index.tsx",
      "default": "./dist/form/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "@sunbeam/source": "./src/i18n/index.ts",
      "default": "./dist/i18n/index.js"
    },
    "./code-editor": {
      "types": "./dist/components/ui/code-editor.d.ts",
      "@sunbeam/source": "./src/components/ui/code-editor.tsx",
      "default": "./dist/components/ui/code-editor.js"
    },
    "./charts": {
      "types": "./dist/components/ui/charts.d.ts",
      "@sunbeam/source": "./src/components/ui/charts.tsx",
      "default": "./dist/components/ui/charts.js"
    },
    "./diagram": {
      "types": "./dist/components/ui/diagram-renderer.d.ts",
      "@sunbeam/source": "./src/components/ui/diagram-renderer.tsx",
      "default": "./dist/components/ui/diagram-renderer.js"
    },
    "./markdown": {
      "types": "./dist/components/ui/markdown-renderer.d.ts",
      "@sunbeam/source": "./src/components/ui/markdown-renderer.tsx",
      "default": "./dist/components/ui/markdown-renderer.js"
    },
    "./math": {
      "types": "./dist/components/ui/math-renderer.d.ts",
      "@sunbeam/source": "./src/components/ui/math-renderer.tsx",
      "default": "./dist/components/ui/math-renderer.js"
    },
    "./kanban": {
      "types": "./dist/components/ui/kanban-board.d.ts",
      "@sunbeam/source": "./src/components/ui/kanban-board.tsx",
      "default": "./dist/components/ui/kanban-board.js"
    },
    "./syntax-highlighter": {
      "types": "./dist/components/ui/syntax-highlighter.d.ts",
      "@sunbeam/source": "./src/components/ui/syntax-highlighter.tsx",
      "default": "./dist/components/ui/syntax-highlighter.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "panda codegen",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1",
    "@tanstack/react-router": "^1.170.4",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^2.0.0",
    "jsdom": "^24.0.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://src.sunbeam.pt/api/packages/studio/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://src.sunbeam.pt/studio/beam-ui"
  },
  "license": "MIT",
