{
  "name": "@sunbeam/beam-ui",
  "version": "0.8.7",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "default": "./dist/preset.js"
    },
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/global.css": "./src/styles/global.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "default": "./dist/data/*.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "default": "./dist/form/index.js"
    },
    "./stores/*": {
      "types": "./dist/stores/*.d.ts",
      "default": "./dist/stores/*.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "default": "./dist/i18n/index.js"
    }
  },
  "scripts": {
    "codegen": "panda codegen",
    "build": "panda codegen && tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1"
  },
  "files": [
    "dist",
    "src/styles"
  ],
  "publishConfig": {
    "registry": "https://src.sunbeam.pt/api/packages/studio/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://src.sunbeam.pt/studio/beam-ui"
  },
  "license": "MIT",
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "katex": "^0.16.44",
    "mermaid": "^11.14.0",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "shiki": "^4.0.2",
    "turndown": "^7.2.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ark-ui/react": "^4.0.0",
    "@pandacss/dev": "^1.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
