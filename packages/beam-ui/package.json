{
  "name": "@sunbeam/beam-ui",
  "version": "0.8.8",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "@sunbeam/source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./preset": {
      "types": "./dist/preset.d.ts",
      "@sunbeam/source": "./src/preset.ts",
      "default": "./dist/preset.js"
    },
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/global.css": "./src/styles/global.css",
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "@sunbeam/source": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "@sunbeam/source": "./src/hooks/*.ts",
      "default": "./dist/hooks/*.js"
    },
    "./data/*": {
      "types": "./dist/data/*.d.ts",
      "@sunbeam/source": "./src/data/*.ts",
      "default": "./dist/data/*.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "@sunbeam/source": "./src/form/index.tsx",
      "default": "./dist/form/index.js"
    },
    "./stores/*": {
      "types": "./dist/stores/*.d.ts",
      "@sunbeam/source": "./src/stores/*.ts",
      "default": "./dist/stores/*.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "@sunbeam/source": "./src/i18n/index.ts",
      "default": "./dist/i18n/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "panda codegen",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@pandacss/dev": "^1.9.1",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.1",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/ui": "^2.0.0",
    "jsdom": "^24.0.0",
    "vitest": "^2.0.0"
  },
  "files": [
    "dist",
    "src"
  ],
  "publishConfig": {
    "registry": "https://src.sunbeam.pt/api/packages/studio/npm/"
  },
  "repository": {
    "type": "git",
    "url": "https://src.sunbeam.pt/studio/beam-ui"
  },
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.41.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@lezer/highlight": "^1.2.1",
    "katex": "^0.16.44",
    "mermaid": "^11.14.0",
    "react-hook-form": "^7.72.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.0.2",
    "turndown": "^7.2.2",
    "unified": "^11.0.5",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@ark-ui/react": "^4.0.0",
    "@pandacss/dev": "^1.9.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "zustand": "^5.0.0"
  }
}
